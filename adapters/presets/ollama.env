# 7Ei MC adapter — local Ollama brain (OpenAI-compatible, no API key). Copy to mc.env
#   1. Install + run Ollama:  https://ollama.com   (serves http://localhost:11434)
#   2. Pull the model:        ollama pull llama3.1   (must match MC_LLM_MODEL below)
MC_BASE_URL=https://7ei-backend.fly.dev
MC_AGENT_TOKEN=<paste-agent-token>
MC_WORKDIR=/Users/artutito/7Ei-MC_TARCO
MC_ALLOW_SHELL=0
MC_POLL_SECONDS=20

MC_EXECUTOR=llm
MC_MAX_STEPS=4
MC_LLM_BASE_URL=http://localhost:11434/v1
# Ollama needs no key — leave MC_LLM_API_KEY empty.
MC_LLM_API_KEY=
MC_LLM_MODEL=llama3.1
