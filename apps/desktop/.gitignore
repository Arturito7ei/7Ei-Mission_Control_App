# Epic H — build artifacts (never committed; regenerated by build-desktop.mjs)
node_modules/
dist/
build-stage/

# The repo-root .gitignore ignores `build/` as build OUTPUT, but apps/desktop/build/
# holds committed build INPUTS (the app icon + hardened-runtime entitlements) that
# electron-builder reads. Un-ignore the directory + its contents so a fresh checkout
# can reproduce a signed build.
!build/
!build/**
